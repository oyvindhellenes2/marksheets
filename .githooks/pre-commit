#!/bin/sh
# Two things, neither of which blocks a commit.
#
# 1. Regenerate the ADR index, since it is derived from the records.
# 2. Say something when code changes without any prose changing. It is a
#    reminder, not a gate: a hook that refuses commits gets --no-verify'd
#    within the week, and then it is worse than nothing.

root=$(git rev-parse --show-toplevel)

if [ -d "$root/adr" ]; then
	python3 "$root/.githooks/adr-index"
	if [ $? -eq 10 ]; then
		git add "$root/adr/README.md"
	fi
fi

staged=$(git diff --cached --name-only)
code=$(printf '%s\n' "$staged" | grep -E '^(cmd|internal)/' || true)
prose=$(printf '%s\n' "$staged" | grep -E '\.md$' || true)

if [ -n "$code" ] && [ -z "$prose" ]; then
	printf '\n  This commit changes code and no prose.\n'
	printf '    SPEC.md   if behaviour changed\n'
	printf '    adr/      if a decision was made you would not want to re-argue\n'
	printf '    CLAUDE.md if an invariant or a way of working changed\n'
	printf '  Committing anyway.\n\n'
fi

exit 0
